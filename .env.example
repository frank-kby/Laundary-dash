# Laundry Dash — environment template. PLACEHOLDERS ONLY. Copy to server/.env for local dev.
# Never commit real values. On Render, set these in the service's Environment settings.

NODE_ENV=development
PORT=3000
# Neon: use the pooled connection string, append ?sslmode=require and set DATABASE_SSL=true
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/laundry_dash
DATABASE_SSL=false
# Public URL of the app (https in production), e.g. https://laundry-dash.onrender.com
APP_ORIGIN=http://localhost:5173
# Comma-separated extra origins allowed to send state-changing requests (dev only)
EXTRA_ALLOWED_ORIGINS=http://localhost:3000
# Number of proxy hops in front of the app (Render = 1)
TRUST_PROXY=0
RUN_MIGRATIONS_ON_START=false

# Sessions
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=24
SESSION_PERSISTENT_DAYS=30

# Email: none | console (development only) | resend
EMAIL_PROVIDER=none
EMAIL_FROM="Laundry Dash <no-reply@your-verified-domain.example>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Photos: none | local (development only) | s3 (Cloudflare R2 / S3-compatible, PRIVATE bucket)
PHOTO_STORAGE=none
LOCAL_UPLOAD_DIR=./data/uploads
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=laundry-dash-photos
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Mobile Money: none | simulator (TEST MODE — no real money) | mtn_momo (not yet verified with real credentials)
PAYMENT_PROVIDER=none
# Random string >= 16 chars (e.g. `openssl rand -hex 32`); required when a provider is enabled
PAYMENT_WEBHOOK_SECRET=replace-with-long-random-string
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=replace-me
MTN_MOMO_API_USER=replace-me
MTN_MOMO_API_KEY=replace-me
MTN_MOMO_CURRENCY=RWF

# Support contacts shown in the app (replace with the business's real numbers)
SUPPORT_PHONE=+250780000000
SUPPORT_WHATSAPP=250780000000
BUSINESS_TIMEZONE=Africa/Kigali
