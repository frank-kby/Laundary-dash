{
  "name": "laundry-dash-server",
  "version": "0.1.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "create-admin": "tsx --env-file-if-exists=.env src/createAdmin.ts",
    "create-admin:prod": "node dist/createAdmin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "aws4fetch": "^1.0.20",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
